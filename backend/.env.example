# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-server-side-secret
FRONTEND_ORIGIN=http://localhost:3000

# Supabase / PostgreSQL (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-key

# Google OAuth (server-side only)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Provisional market-data integration (server-side only)
MARKET_DATA_PROVIDER=upstox
UPSTOX_CLIENT_ID=replace-with-provider-client-id
UPSTOX_CLIENT_SECRET=replace-with-provider-client-secret
UPSTOX_REDIRECT_URI=http://localhost:8000/market/upstox/callback
